# Celiador daemon — PROD environment (celiador.ai).
# On the box this lives at ~/envs/prod/daemon.env (chmod 600), loaded by the
# systemd unit `celiador-daemon@prod` via EnvironmentFile — NOT committed.
# Copy to that path and fill in real secrets. Keys are read by src/config.ts / src/auth.ts.
# NOTE: systemd EnvironmentFile does NOT strip inline "# comments" — keep every
# comment on its own line; `KEY=` must be followed by the value and nothing else.

# --- Server ---
PORT=4671
HOST=127.0.0.1
CELIADOR_HOME=/home/stefan/envs/prod/daemon

# --- Anthropic (agent proxy) ---
# PROD key
ANTHROPIC_API_KEY=
CELIADOR_AGENT_MODEL=claude-opus-4-8
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# Signup is open, so these cap what any one account can spend on the shared key.
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# Restrict the agent to paying plans (profiles.plan values, comma-separated; needs DATABASE_URL):
# CELIADOR_AGENT_PLANS=pro,team

# --- Database (durable app data: profiles + chat history) ---
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5535/celiador_prod
# DATABASE_POOL_MAX=5
# DATABASE_SSL=require

# --- Auth: supabase mode (per-env JWT secret is the isolation boundary) ---
# PROD secret — must match the prod GoTrue's GOTRUE_JWT_SECRET. The daemon refuses to
# start if this (and CELIADOR_TOKEN) is empty.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://celiador.ai
# prod anon key
SUPABASE_ANON_KEY=
# Optional: direct GoTrue admin URL used for account deletion (default SUPABASE_URL/auth/v1).
# GOTRUE_URL=http://127.0.0.1:9998

# Shared secret for the agent proxy / CI smoke tests when there is no user JWT.
CELIADOR_AGENT_TOKEN=

# --- APNs push ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion
APNS_ENV=production
