# Templated systemd unit for the Celiador daemon — one instance per environment.
# Mirrors the live prod unit (celiador-daemon.service) but parameterized by %i
# (the env slug: prod|staging|dev). Each instance runs from its own checkout and
# reads its own ~/envs/%i/daemon/.env (the daemon's loadDotEnv reads .env from
# CELIADOR_HOME / the working dir — same mechanism prod uses from ~/daemon/.env).
#
# Install:
#   sudo cp celiador-daemon@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now celiador-daemon@staging
#   sudo systemctl enable --now celiador-daemon@dev
# (Prod keeps the existing celiador-daemon.service until a deliberate cutover to
#  celiador-daemon@prod.)

[Unit]
Description=Celiador daemon (%i)
After=network.target

[Service]
Type=simple
User=stefan
WorkingDirectory=/home/stefan/envs/%i/daemon
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
