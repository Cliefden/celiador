# Celiador daemon — environment.
# Copy to .env and fill in. The daemon reads .env from CELIADOR_HOME (or cwd).

# --- Server ---
PORT=4661
HOST=127.0.0.1
# CELIADOR_HOME=/home/stefan/daemon        # where data/ lives; defaults to cwd

# --- Anthropic (agent proxy) ---
ANTHROPIC_API_KEY=sk-ant-...
# CELIADOR_AGENT_MODEL=claude-opus-4-8      # override the proxied model
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Database (durable app data: profiles + chat history) ---
# Postgres connection to the Celiador Supabase DB. Unset = persistence is a no-op.
# Self-hosted example via the local pooler on the box:
#   DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5535/postgres
# DATABASE_URL=
# DATABASE_POOL_MAX=5
# DATABASE_SSL=require   # set only if connecting over TLS to a verified endpoint
#
# IMPORTANT: For DELETE /api/account to work (Apple requirement), the DB role must
# have DELETE permission on auth.users. Grant via psql:
#   GRANT DELETE ON auth.users TO <your_db_role>;
# Without this grant, account deletion returns 500 with "server misconfigured".

# --- Auth (pick one mode) ---
# supabase mode: verify end-user HS256 JWTs
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://celiador.ai
SUPABASE_ANON_KEY=
# token mode (single-user shared secret): CELIADOR_TOKEN=...
# none mode: leave the above unset (localhost dev only)

# Shared secret the clients may use for the agent proxy when they have no user JWT.
CELIADOR_AGENT_TOKEN=

# --- APNs push (optional; push is a no-op if unset) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_KEY=            # the .p8 PEM contents, OR:
APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion
#
# NOTE: There is no global APNS_ENV setting. The sandbox vs production APNs host
# is chosen per-device based on the 'env' field each device registers with via
# POST /api/push/register or POST /api/push/activity. Devices built for development
# register as "sandbox"; App Store/TestFlight devices register as "production".
