# Celiador daemon — environment.
# Copy to .env and fill in. The daemon reads .env from CELIADOR_HOME (or cwd).

# --- Server ---
PORT=4661
HOST=127.0.0.1
# Where data/ (and .env) live; defaults to cwd:
# CELIADOR_HOME=/home/stefan/daemon

# --- Anthropic (agent proxy) ---
ANTHROPIC_API_KEY=sk-ant-...
# Override the proxied model:
# CELIADOR_AGENT_MODEL=claude-opus-4-8
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# Signup is open, so these cap what any one account can spend on the shared key.
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# Restrict the agent to paying plans (profiles.plan values, comma-separated; needs DATABASE_URL):
# CELIADOR_AGENT_PLANS=pro,team

# --- Database (durable app data: profiles + chat history) ---
# Postgres connection to the Celiador Supabase DB. Unset = persistence is a no-op.
# Self-hosted example via the local pooler on the box:
#   DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5535/postgres
# DATABASE_URL=
# DATABASE_POOL_MAX=5
# Set only if connecting over TLS to a verified endpoint:
# DATABASE_SSL=require

# --- Auth (pick one mode) ---
# supabase mode: verify end-user HS256 JWTs
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://celiador.ai
SUPABASE_ANON_KEY=
# token mode (single-user shared secret): CELIADOR_TOKEN=...
# none mode: leave the above unset AND set CELIADOR_ALLOW_NO_AUTH=1 (loopback dev only;
# the daemon refuses to start in none mode otherwise)
# CELIADOR_ALLOW_NO_AUTH=1

# Shared secret the clients may use for the agent proxy when they have no user JWT.
CELIADOR_AGENT_TOKEN=

# --- APNs push (optional; push is a no-op if unset) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8 PEM contents, OR APNS_KEY_PATH:
# APNS_KEY=
APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion
APNS_ENV=sandbox
