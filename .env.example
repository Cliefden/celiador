# Celiador daemon — environment.
# Copy to .env and fill in. The daemon reads .env from CELIADOR_HOME (or cwd).

# --- Server ---
PORT=4661
HOST=127.0.0.1
# Where data/ (and .env) live; defaults to cwd:
# CELIADOR_HOME=/home/stefan/daemon
# Editor releases (update feed + downloads): where the release script rsyncs
# artifacts + manifest.json, and the public origin download URLs are built on.
# CELIADOR_RELEASES_DIR=/home/stefan/daemon/releases
# CELIADOR_PUBLIC_URL=https://celiador.ai

# --- GitHub (agent task queue) ---
# Per-repo webhooks sign with this secret. The Celiador GitHub App (created once
# via GET /api/github/app/new, stored in data/github-app.json) has its own.
# CELIADOR_GITHUB_WEBHOOK_SECRET=...
# The organization the GitHub App is created under (the setup page targets it).
# CELIADOR_GITHUB_ORG=Cliefden

# --- Anthropic (agent proxy) ---
ANTHROPIC_API_KEY=sk-ant-...
# Override the proxied model:
# CELIADOR_AGENT_MODEL=claude-opus-4-8
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- First-party Anthropic gateway (/api/anthropic/v1/*) ---
# Forwards a client's own system prompt + tool schemas (the Claude Agent SDK's full
# toolset) while the daemon keeps key custody, model choice, token caps and quota.
# On by default; set to 0 to allow only the locked 3-tool proxy (runner tokens still
# get gateway access regardless):
# CELIADOR_AGENT_GATEWAY=1
# Allow clients to pick from these model ids (comma-separated); unset = always force
# CELIADOR_AGENT_MODEL:
# CELIADOR_AGENT_MODELS=claude-opus-4-8,claude-haiku-4-5-20251001
# Where the daemon sends its OWN upstream calls (clients never see this):
# ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
# Gateway payload caps:
# CELIADOR_GATEWAY_MAX_TOOLS=100
# CELIADOR_GATEWAY_MAX_TOOLS_BYTES=524288
# CELIADOR_GATEWAY_MAX_SYSTEM_BYTES=262144

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# Signup is open, so these cap what any one account can spend on the shared key.
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# And across ALL accounts together, so scripted signups can't run the key dry:
# CELIADOR_AGENT_GLOBAL_DAILY_REQUESTS=3000
# CELIADOR_AGENT_GLOBAL_DAILY_INPUT_TOKENS=20000000
# CELIADOR_AGENT_GLOBAL_DAILY_OUTPUT_TOKENS=1000000
# Accounts (Supabase user ids, comma-separated) that may read GET /api/admin/usage:
# CELIADOR_ADMIN_USER_IDS=
# Restrict the agent to paying plans (profiles.plan values, comma-separated; needs DATABASE_URL):
# CELIADOR_AGENT_PLANS=pro,team

# --- Inline completion ("Tab autocomplete", /api/complete) ---
# A small fast model with its own per-user caps, independent of the agent proxy.
# CELIADOR_COMPLETE_MODEL=claude-haiku-4-5
# CELIADOR_COMPLETE_MAX_TOKENS=64
# CELIADOR_COMPLETE_RPM=120
# CELIADOR_COMPLETE_DAILY_OUTPUT_TOKENS=200000

# --- Database (durable app data: profiles + chat history) ---
# Postgres connection to the Celiador Supabase DB. Unset = persistence is a no-op.
# Self-hosted example via the local pooler on the box:
#   DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5535/postgres
# DATABASE_URL=
# DATABASE_POOL_MAX=5
# Set only if connecting over TLS to a verified endpoint:
# DATABASE_SSL=require
# For DELETE /api/account's DB fallback (when GoTrue admin isn't reachable), the
# role needs: GRANT DELETE ON auth.users TO <your_db_role>;

# --- Auth (pick one mode) ---
# supabase mode: verify end-user HS256 JWTs
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://celiador.ai
SUPABASE_ANON_KEY=
# token mode (single-user shared secret): CELIADOR_TOKEN=...
# none mode: leave the above unset AND set CELIADOR_ALLOW_NO_AUTH=1 (loopback dev only;
# the daemon refuses to start in none mode otherwise)
# CELIADOR_ALLOW_NO_AUTH=1

# Shared secret the clients may use for the agent proxy when they have no user JWT.
CELIADOR_AGENT_TOKEN=

# --- APNs push (optional; push is a no-op if unset) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8 PEM contents, OR APNS_KEY_PATH:
# APNS_KEY=
APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion
APNS_ENV=sandbox
