# Celiador daemon — TEST/STAGING environment (staging.celiador.ai).
# On the box: ~/envs/staging/daemon.env (chmod 600), loaded by `celiador-daemon@staging`.
# Prod-like, but a SEPARATE auth store + a SAFE Anthropic key. Never committed.
# NOTE: systemd EnvironmentFile does NOT strip inline "# comments" — keep every
# comment on its own line; `KEY=` must be followed by the value and nothing else.

# --- Server ---
PORT=4672
HOST=127.0.0.1
CELIADOR_HOME=/home/stefan/envs/staging/daemon

# --- Anthropic (agent proxy) ---
# SAFE/test key (separate spend + can be killed independently)
ANTHROPIC_API_KEY=
CELIADOR_AGENT_MODEL=claude-opus-4-8
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# Signup is open, so these cap what any one account can spend on the shared key.
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# Restrict the agent to paying plans (profiles.plan values, comma-separated; needs DATABASE_URL):
# CELIADOR_AGENT_PLANS=pro,team

# --- Database ---
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5535/celiador_staging
# DATABASE_POOL_MAX=5
# DATABASE_SSL=require

# --- Auth: supabase mode. DISTINCT secret from prod — a staging token must 401 on prod. ---
# STAGING secret — must match the staging GoTrue's GOTRUE_JWT_SECRET
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://staging.celiador.ai
# staging anon key
SUPABASE_ANON_KEY=

CELIADOR_AGENT_TOKEN=

# --- APNs push (sandbox + a distinct topic so it can't touch prod devices) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion.staging
APNS_ENV=sandbox
