# Read by `wb` (github.com/Cliefden/workbench) — worktrees, board, merge
# trains, dev stack. The manual is workbench's WORKTREES.md.
WB_PROJECT="Celiador"

wb_setup() {
  npm --prefix daemon install
  npm --prefix web install
  npm --prefix packages/client install
  # The .xcodeproj is generated, per worktree.
  if command -v xcodegen >/dev/null; then
    (cd ios && xcodegen generate)
  else
    echo "⚠ xcodegen is not on PATH — run 'xcodegen generate' in ios/ before building"
  fi
}

# Forward-only migrations: `wb status` / `wb map` warn when two worktrees (or a
# worktree and main) take the same migration number; `wb train build` leaves
# the second one out.
WB_MIGRATIONS="daemon/db/migrations"

# `wb issue` offers these area labels and guesses one from the text.
WB_AREAS=(
  "daemon=daemon|api|server|gateway|relay|webhook|runner|sandbox|quota|apns|push|supabase|auth|deploy"
  "ios=ios|iphone|ipad|app|swift|swiftui|widget|widgets|live activity|testflight|xcode|watch"
  "web=web|site|website|celiador\.ai|next|nextjs|page|landing|seo"
)

# Generated from packages/client/openapi.yaml: a merge train that conflicts
# only here makes them again instead of leaving the PR out.
WB_GENERATED="packages/client/src/schema.ts"
wb_regen() {
  npm --prefix packages/client ci --silent
  npm --prefix packages/client run generate --silent
}

WB_SERVICES="daemon web"
WB_daemon_DIR="daemon"
WB_daemon_CMD="npm run dev"
WB_daemon_PORT=4661
WB_daemon_HEALTH="http://127.0.0.1:4661/api/health"
WB_web_DIR="web"
WB_web_CMD="npm run dev"
WB_web_PORT=3000
