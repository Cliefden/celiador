# Celiador daemon — DEV environment.
# Two ways to run dev:
#   A) Local laptop: copy to daemon/.env, leave SUPABASE_JWT_SECRET empty, uncomment
#      CELIADOR_ALLOW_NO_AUTH=1 → auth mode = "none" (loopback only), and comment out
#      PORT → `npm run dev` on the default :4661.
#   B) Shared box stack (dev.celiador.ai): ~/envs/dev/daemon.env, `celiador-daemon@dev` on :4673
#      (matches deploy/deploy.sh + Caddy).
# Never committed.
# NOTE: systemd EnvironmentFile does NOT strip inline "# comments" — keep every
# comment on its own line; `KEY=` must be followed by the value and nothing else.

# --- Server ---
# Box dev stack (B) port. For local laptop dev (A) comment this out (default 4661).
PORT=4673
HOST=127.0.0.1
# Only for the box dev stack:
# CELIADOR_HOME=/home/stefan/envs/dev/daemon

# --- Anthropic (agent proxy) — use a cheap model + throwaway key for dev ---
ANTHROPIC_API_KEY=
CELIADOR_AGENT_MODEL=claude-haiku-4-5
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# Signup is open, so these cap what any one account can spend on the shared key.
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# Restrict the agent to paying plans (profiles.plan values, comma-separated; needs DATABASE_URL):
# CELIADOR_AGENT_PLANS=pro,team

# --- Database (optional in dev; unset = persistence is a no-op) ---
# DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5535/celiador_dev

# --- Auth ---
# Local (A): leave SUPABASE_JWT_SECRET empty and allow no-auth mode explicitly
#            (single "default" user; refused unless HOST is loopback):
# CELIADOR_ALLOW_NO_AUTH=1
# Box (B):   set a DISTINCT dev secret matching the dev GoTrue to test real sign-in.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://dev.celiador.ai
SUPABASE_ANON_KEY=

CELIADOR_AGENT_TOKEN=

# --- APNs push (sandbox + distinct topic; usually unset locally so push is a no-op) ---
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion.dev
APNS_ENV=sandbox
