// Shared base for all channels. Channel files (Dev/Test/Prod) #include this
// and override CELIADOR_DAEMON_URL / BUNDLE_ID_SUFFIX / APP_NAME / URL_SCHEME.
//
// NOTE: `//` starts a comment in xcconfig, so URLs are written with the `$()`
// trick — `https:/$()/host` expands to `https://host`.

BUNDLE_ID_SUFFIX =
APP_NAME = Celiador
URL_SCHEME = celiador
CELIADOR_DAEMON_URL = https:/$()/celiador.ai
// Short commit of the build; CI passes CELIADOR_COMMIT=<sha7> to xcodebuild
// (ios.yml), a build from Xcode leaves it empty ("local build" in Settings).
CELIADOR_COMMIT =
