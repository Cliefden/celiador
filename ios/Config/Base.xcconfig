// Shared base for all channels. Channel files (Dev/Staging/Prod) #include this
// and override CELIADOR_DAEMON_URL / BUNDLE_ID_SUFFIX / APP_NAME / URL_SCHEME.
//
// NOTE: `//` starts a comment in xcconfig, so URLs are written with the `$()`
// trick — `https:/$()/host` expands to `https://host`.

BUNDLE_ID_SUFFIX =
APP_NAME = Celiador
URL_SCHEME = celiador
CELIADOR_DAEMON_URL = https:/$()/celiador.ai
