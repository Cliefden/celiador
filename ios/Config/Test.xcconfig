#include "Base.xcconfig"

// TEST — its own app, "Celiador Test" (bundle id suffix .test, URL scheme
// celiador-test), pointed at the always-on test environment. This is what a
// vX.Y.Z tag ships to TestFlight. Three apps install side by side (Dev, Test,
// the App Store app), so a Test build never replaces the prod install on a
// phone — the earlier two-app model (Test = prod bundle id) did, and hid
// prod's data. The App Store build is the Release config.
BUNDLE_ID_SUFFIX = .test
APP_NAME = Celiador Test
URL_SCHEME = celiador-test
CELIADOR_DAEMON_URL = https:/$()/test.celiador.ai
