# Celiador daemon — DEV environment.
# Two ways to run dev:
#   A) Local laptop: copy to daemon/.env, leave SUPABASE_JWT_SECRET empty, set
#      CELIADOR_ALLOW_NO_AUTH=1 → auth mode "none" (loopback only), and comment
#      out PORT → `npm run dev` on the default :4661 (`wb dev`).
#   B) The shared box stack (dev.celiador.ai): ~/envs/dev/daemon/.env, written by
#      deploy/provision-env.sh, run by `celiador-daemon@dev` on :4673. Its own
#      Postgres + GoTrue (compose project celiador-dev). Deployed on every push
#      to main.
# Never committed.

# --- Server ---
# `local` on a laptop; `dev` on the box.
CELIADOR_ENV=dev
# Box dev stack (B) port. For local laptop dev (A) comment this out (default 4661).
PORT=4673
HOST=127.0.0.1
# Only for the box dev stack:
# CELIADOR_HOME=/home/stefan/envs/dev/daemon
# CELIADOR_PUBLIC_URL=https://dev.celiador.ai

# --- Anthropic (agent proxy) — a cheap model + throwaway key for dev ---
ANTHROPIC_API_KEY=
CELIADOR_AGENT_MODEL=claude-haiku-4-5
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# CELIADOR_AGENT_PLANS=pro,team

# --- Database (optional locally; unset = persistence is a no-op) ---
# Box: this environment's own Postgres (loopback :5434).
# DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5434/postgres

# --- Auth ---
# Local (A): leave SUPABASE_JWT_SECRET empty and allow no-auth mode explicitly
#            (single "default" user; refused unless HOST is loopback):
# CELIADOR_ALLOW_NO_AUTH=1
# Box (B):   the dev GoTrue's secret (generated by provision-env.sh) — DISTINCT
#            from prod and test.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://dev.celiador.ai
SUPABASE_ANON_KEY=
# GOTRUE_URL=http://127.0.0.1:9996

CELIADOR_AGENT_TOKEN=

# --- APNs push (the dev app's topic; usually unset locally so push is a no-op) ---
# TestFlight builds of the dev app use the production APNs environment; a build
# run from Xcode uses sandbox — until the daemon sends per device, pick the one
# you are testing with.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion.dev
APNS_ENV=production
