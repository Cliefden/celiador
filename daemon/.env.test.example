# Celiador daemon — TEST environment (test.celiador.ai).
# On the box: ~/envs/test/daemon/.env (chmod 600), written by deploy/provision-env.sh
# and read by `celiador-daemon@test` (the daemon's own loadDotEnv). Never committed.
# Prod-like, with its OWN Postgres + GoTrue (compose project celiador-test) and a
# SAFE Anthropic key. Deployed on every vX.Y.Z tag.

# --- Server ---
CELIADOR_ENV=test
PORT=4672
HOST=127.0.0.1
CELIADOR_HOME=/home/stefan/envs/test/daemon
CELIADOR_PUBLIC_URL=https://test.celiador.ai

# --- Anthropic (agent proxy) ---
# SAFE/test key (separate spend + can be killed independently)
ANTHROPIC_API_KEY=
CELIADOR_AGENT_MODEL=claude-opus-4-8
# CELIADOR_AGENT_MAX_TOKENS=32000

# --- Agent proxy limits (per user, per UTC day; 0 = unlimited) ---
# CELIADOR_AGENT_RPM=30
# CELIADOR_AGENT_CONCURRENCY=2
# CELIADOR_AGENT_DAILY_REQUESTS=500
# CELIADOR_AGENT_DAILY_INPUT_TOKENS=5000000
# CELIADOR_AGENT_DAILY_OUTPUT_TOKENS=300000
# CELIADOR_AGENT_PLANS=pro,team

# --- Database: this environment's own Postgres (loopback :5433) ---
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5433/postgres
# DATABASE_POOL_MAX=5

# --- Auth: supabase mode. DISTINCT secret from prod — a test token must 401 on prod. ---
# == the test GoTrue's GOTRUE_JWT_SECRET (generated by provision-env.sh)
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://test.celiador.ai
# the test anon key (minted from the secret above)
SUPABASE_ANON_KEY=
GOTRUE_URL=http://127.0.0.1:9997

CELIADOR_AGENT_TOKEN=

# --- APNs push ---
# The test app IS the prod bundle (TestFlight builds of ai.celiador.companion
# pointed at test.celiador.ai), so the topic is the prod one; TestFlight uses the
# production APNs environment. Devices register with test's daemon only.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=ai.celiador.companion
APNS_ENV=production
